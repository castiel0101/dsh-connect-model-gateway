{
  "name": "dsh-connect-model-gateway",
  "displayName": "魔桥 · DSH Model Gateway",
  "version": "0.13.1",
  "description": "魔桥（Model Gateway）：一个插件收进各家「积分换模型」的平台——WorkBuddy / CodeArts / 秒悟 Meoo / SCNet / 灵犀 / 商汤小浣熊。统一登录与账号池、积分余额、模型目录与开关、自动签到，模型直接出现在 DSH 模型选择器里。",
  "type": "module",
  "license": "MIT",
  "author": "JackLeo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/castiel0101/dsh-connect-model-gateway.git"
  },
  "homepage": "https://github.com/castiel0101/dsh-connect-model-gateway#readme",
  "bugs": "https://github.com/castiel0101/dsh-connect-model-gateway/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-provider",
    "model-gateway",
    "points",
    "workbuddy",
    "codearts",
    "meoo",
    "scnet",
    "lingxi",
    "raccoon"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./adapters/workbuddy": "./lib/adapters/workbuddy.js",
    "./adapters/codearts": "./lib/adapters/codearts.js",
    "./adapters/meoo": "./lib/adapters/meoo.js",
    "./adapters/scnet": "./lib/adapters/scnet.js",
    "./adapters/lingxi": "./lib/adapters/lingxi.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./adapters/raccoon": "./lib/adapters/raccoon.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
